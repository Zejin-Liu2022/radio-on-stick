[Unit]
Description=Radio Directory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radio-directory
Group=radio-directory
EnvironmentFile=/etc/radio-directory.env
ExecStart=/opt/radio-directory/radio-directory
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/radio-directory
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=4096
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
